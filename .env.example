# OVRA Platform Environment Configuration

# Public Supabase Client Keys (Safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-Side Privileged Supabase Key (Server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PostgreSQL Direct Connection for Drizzle ORM
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Security: Credential Key Encryption Key (32-byte hex for AES-256-GCM envelope encryption)
OVRA_CREDENTIAL_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Internal Worker / Queue Secret (Authorized webhook trigger & queue runner)
OVRA_INTERNAL_WORKER_SECRET=ovra_internal_worker_secret_key_change_me
